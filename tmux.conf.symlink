# tmux configuration
# https://man.openbsd.org/tmux

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Set the default character encoding to UTF-8
set -g default-terminal "screen-256color"

# Increase the scrollback buffer size
set -g history-limit 20000

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Screen-like keybindings (only overrides where tmux defaults differ)

# Change prefix from Ctrl-b to Ctrl-a
unbind C-b
set -g prefix C-a

# Ctrl-a a sends Ctrl-a to the shell (e.g. move to start of line)
bind a send-prefix

# Ctrl-a Ctrl-a to toggle last window
bind-key C-a last-window

# Screen-like window kill
bind k confirm-before -p "kill-window #W? (y/n)" kill-window
bind '\' confirm-before -p "kill-server? (y/n)" kill-server

# Screen-like window list (tmux default " is split-window)
bind '"' choose-window

# Screen-like window rename (tmux default is ,)
bind A command-prompt "rename-window '%%'"

# Screen-like split
bind S split-window -v
bind | split-window -h

# Screen-like next window on space (tmux default is next-layout)
bind space next-window
bind BSpace previous-window

# Screen-like lockscreen (tmux default x is kill-pane)
bind x lock-server
set -g lock-command "vlock"
