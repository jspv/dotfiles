#
# Usage: csess [project] [count]
# Description: list recent Claude Code sessions, newest first: the session ID
#   (resume it with `claude --resume <id>`), when it was last used, and its
#   title (Claude's own title or summary, else the first real prompt).
#
#   csess                          # sessions for the current directory, 15 newest
#   csess "" 30                    # same, 30 newest
#   csess -workspaces-glidepath    # a project folder under ~/.claude/projects
#   csess ~/.claude/projects/-Users-jspv-src-glidepath 5
#
# Claude names a project folder after its directory with every character that
# is not a letter or digit replaced by "-" (/workspaces/glidepath ->
# -workspaces-glidepath). Honours CLAUDE_CONFIG_DIR. Needs jq. Works on macOS
# and Linux (uses zsh's zstat rather than stat(1), whose flags differ).
csess () {
    emulate -L zsh
    zmodload -F zsh/stat b:zstat || return 1
    (( $+commands[jq] )) || { print -u2 "csess: needs jq"; return 1 }

    local root=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects
    local d=${1:-$root/${PWD//[^A-Za-z0-9]/-}}
    [[ ! -d $d && -n $1 && -d $root/$1 ]] && d=$root/$1
    [[ -d $d ]] || { print -u2 "csess: no Claude sessions folder: $d"; return 1 }

    local -a files mt
    files=($d/*.jsonl(Nom[1,${2:-15}]))
    (( $#files )) || { print -u2 "csess: no sessions in $d"; return 1 }

    local f age title now=$(date +%s)
    for f in $files; do
        zstat -A mt +mtime -- $f
        age=$(( now - mt[1] ))
        if (( age < 3600 )); then age="$(( age/60 ))m ago"
        elif (( age < 86400 )); then age="$(( age/3600 ))h ago"
        else age="$(( age/86400 ))d ago"; fi

        title=$(jq -r 'select(.type=="summary" or .type=="custom-title" or .type=="ai-title") | (.summary // .customTitle // .aiTitle // .title // empty)' $f 2>/dev/null | tail -1)
        [[ -z $title ]] && title=$(jq -r 'select(.type=="user") | .message.content | if type=="string" then . else .[0].text // empty end' $f 2>/dev/null | grep -vE '^<(local-command|command-|system-reminder)' | grep -m1 .)
        printf '%-36s  %-8s  %s\n' "${f:t:r}" "$age" "${title:0:70}"
    done
}
